            ],
            "type": {
              "array": [
                "u8",
                32
              ]
            }
          },
          {
            "name": "nonce",
            "docs": [
              "Number of that key. Grows by one with every signature."
            ],
            "type": "u64"
          },
          {
            "name": "pending",
            "docs": [
